# ==========================================
# 9Paws Mobile App - Environment Variables
# ==========================================
# Lưu ý quan trọng:
# 1. Mọi biến dùng trong App bắt buộc phải có tiền tố "EXPO_PUBLIC_".
# 2. File này là bản mẫu (.example), hãy copy thành ".env" trên máy cá nhân:
#    - Terminal: cp .env.example .env
# 3. KHÔNG commit file ".env" chứa thông tin nhạy cảm cá nhân lên Git.
# ==========================================

# BACKEND API CONFIGURATION
EXPO_PUBLIC_API_BASE_URL=https://ninepaws.dpdns.org/api/v1

# GOOGLE AUTHENTICATION CONFIGURATION (OAuth 2.0 Web Client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
