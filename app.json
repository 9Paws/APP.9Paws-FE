{
  "expo": {
    "name": "9Paws",
    "slug": "9Paws",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app9pawsfe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ninepaws.app",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ninepaws.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "image": "./assets/images/icon.png",
          "imageWidth": 100
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withAndroidOptimizations.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "81e5011f-e89f-45ed-bda0-5ee29a7f7876"
      }
    }
  }
}
